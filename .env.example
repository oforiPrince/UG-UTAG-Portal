# Shared
ENVIRONMENT=development
PUBLIC_WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# FastAPI
# Compose derives DATABASE_URL and CELERY_BROKER_URL from these service
# credentials. Use independent, randomly generated production passwords.
POSTGRES_DB=utag_portal
POSTGRES_USER=utag
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Host-published ports (override when running beside another stack)
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
WEB_HOST_PORT=3000
RABBITMQ_DEFAULT_USER=utag
RABBITMQ_DEFAULT_PASS=replace-with-a-random-broker-password
RABBITMQ_DEFAULT_VHOST=utag
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SESSION_COOKIE_NAME=utag_session
CSRF_COOKIE_NAME=utag_csrf
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
APP_SECRET_KEY=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY_VERSION=v1
FIELD_ENCRYPTION_KEYS={"v1":"replace-with-a-separate-32-character-encryption-key"}
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128","172.16.0.0/12"]
MEDIA_BUCKET=utag-media
# Local profile default. Production must use a maintained external S3-compatible endpoint.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
# Required in production. Use aws:kms plus S3_KMS_KEY_ID for managed storage.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
UPLOAD_MAX_BYTES=25000000
PRESIGNED_URL_TTL_SECONDS=900
# Local profile default. Production must use a maintained external scanner address.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=UG UTAG Portal <no-reply@utag-ug.org>
SMTP_USE_TLS=true
# Secretariat inbox that receives public contact-form messages
CONTACT_RECIPIENT_EMAIL=utagoffice@ug.edu.gh

# One-time first administrator; remove after the first successful seed
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Development/test only. Required only while running `make seed-demo`.
DEMO_DATA_PASSWORD=

# Internal monitoring
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=

# Migration rehearsal only; never point the running API at a writable legacy database
LEGACY_DATABASE_URL=
LEGACY_MEDIA_ROOT=

# Next.js server-side API address and browser-facing addresses. These public
# values are embedded during the web image build. Leave them empty behind the
# same-origin Caddy edge; use localhost values only for split-port development.
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Production edge
SITE_DOMAIN=localhost
ACME_EMAIL=operations@example.org
# Single-host production cutover may use host-maintained MinIO/ClamAV via:
#   S3_ENDPOINT_URL=http://s3.utag.internal:9000
#   CLAMAV_HOST=malware-scanner.utag.internal
# Those aliases are defined on the minio/clamav services under the production profile.
