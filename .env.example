# Shared
ENVIRONMENT=development
PUBLIC_WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# FastAPI
DATABASE_URL=postgresql+psycopg://utag:change-me@postgres:5432/utag_portal
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://utag:change-me@rabbitmq:5672/utag
CELERY_RESULT_BACKEND=redis://redis:6379/1
SESSION_COOKIE_NAME=utag_session
CSRF_COOKIE_NAME=utag_csrf
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
APP_SECRET_KEY=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
MEDIA_BUCKET=utag-media
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
UPLOAD_MAX_BYTES=25000000
PRESIGNED_URL_TTL_SECONDS=900
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MALWARE_SCAN_REQUIRED=false

# Transactional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=UG UTAG Portal <no-reply@utag-ug.org>
SMTP_USE_TLS=true
# Secretariat inbox that receives public contact-form messages
CONTACT_RECIPIENT_EMAIL=utagoffice@ug.edu.gh

# One-time first administrator; remove after the first successful seed
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Development/test only. Required only while running `make seed-demo`.
DEMO_DATA_PASSWORD=

# Internal monitoring
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=

# Migration rehearsal only; never point the running API at a writable legacy database
LEGACY_DATABASE_URL=
LEGACY_MEDIA_ROOT=

# Next.js server-side API address and browser-facing addresses. These public
# values are embedded during the web image build. Leave them empty behind the
# same-origin Caddy edge; use localhost values only for split-port development.
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Production edge
SITE_DOMAIN=localhost
