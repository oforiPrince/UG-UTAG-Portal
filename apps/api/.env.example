ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://utag:change-me@127.0.0.1:5433/utag_portal
REDIS_URL=redis://127.0.0.1:6380/0
CELERY_BROKER_URL=amqp://utag:change-me@127.0.0.1:5673/utag
