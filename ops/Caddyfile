{
	email {$ACME_EMAIL:operations@example.org}
	servers {
		protocols h1 h2 h3
	}
}

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	@backend path /api/v1/* /health/* /docs* /metrics
	reverse_proxy @backend api:8000
	reverse_proxy web:3000

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Content-Security-Policy "default-src 'self'; connect-src 'self' https: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	log {
		output stdout
		format json
	}
}
